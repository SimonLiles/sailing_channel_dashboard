---
title: Sailing Channel Dashboard - ER Diagram
---
erDiagram

  %% ====== 01_RAW - Landing Zone ======

  raw_daily_ingest {
    string channel_id PK
    string channel_handle
    string title
    string description
    string join_date
    string view_count
    string subscriber_count
    string video_count
    string is_sub_count_hidden
    string channel_keywords
    string profile_pic
  }

  channel_dimensions {
    string channel_id PK
    string channel_handle "NOT NULL"
    boolean is_active "DEFAULT TRUE"
    string channel_title
    string channel_description
    date join_date
    boolean is_sub_count_hidden
    string channel_keywords
    string profile_pic
    string status
    string type
    string added_by
    timestamp created_at
    timestamp updated_at
  }

  daily_metrics_history {
    string channel_id PK
    date date PK "partition key"
    int64 view_count
    int64 subscriber_count
    int64 video_count
    timestamp created_at
  }

  %% ====== 02_STAGING ======

  vw_stg_daily_metrics {
    string channel_id PK
    string channel_handle
    string channel_title
    string channel_description
    date join_date
    int64 view_count
    int64 subscriber_count
    int64 video_count
    boolean is_sub_count_hidden
    string channel_keywords
    string profile_pic
  }

  %% ====== 03_MARTS ======

  fct_daily_performance {
    string channel_id PK
    date date PK
    int64 view_count
    int64 video_count
    int64 subscriber_count
    int64 daily_new_views
    int64 daily_new_subs
    int64 daily_new_videos
    float64 lifetime_views_per_vid
    float64 lifetime_views_per_sub
    float64 lifetime_subs_per_vid
    float64 views_moving_avg_7d
    float64 sub_velocity_per_10k
  }

  mart_channel_metrics {
    string channel_id PK
    date snapshot_date PK "partition key"
    int64 window_days PK
    int64 subscriber_count
    int64 view_count
    int64 video_count
    int64 total_views_window
    int64 total_subs_window
    int64 new_videos_window
    float64 views_moving_avg_7d
    float64 sub_conversion_rate
    int64 daily_new_subs
    float64 subs_pct_growth
    float64 lifetime_views_per_vid
    float64 views_per_vid_window
    float64 views_per_sub_window
    timestamp created_at
    timestamp updated_at
  }

  mart_channel_metrics_values {
    date snapshot_date PK "partition key"
    string channel_id PK
    int64 window_days "nullable; part of logical key"
    string metric_name PK
    float64 metric_value
    timestamp updated_at
  }

  mart_channel_cohorts {
    date snapshot_date PK "partition key"
    string channel_id PK
    string cohort_type PK
    string cohort_value
    timestamp created_at
    timestamp updated_at
  }

  mart_channel_rankings {
    date snapshot_date PK "partition key"
    string channel_id PK
    string metric_name PK
    int64 window_days "nullable; part of logical key"
    string cohort_type PK
    string cohort_value "nullable; part of logical key"
    int64 ranking
    int64 percentile
    timestamp created_at
    timestamp updated_at
  }

  %% ====== 04_APPS ======

  channel_lookup {
    string channel_id PK
    string channel_title
    string channel_handle
    string profile_pic
    int64 subscriber_count
    int64 view_count
    int64 video_count
  }

  global_summary {
    date date PK
    int64 latest_views
    int64 latest_subs
    int64 active_channels
    float64 avg_daily_views
    float64 avg_daily_subs
    float64 views_moving_avg_7d
    float64 view_growth_pct
  }

  leaderboard_30d {
    string channel_id PK
    string channel_title
    string channel_handle
    string profile_pic
    int64 subscriber_count
    int64 view_count
    int64 video_count
    int64 total_views_30d
    int64 total_subs_30d
    int64 new_videos_30d
    float64 sub_conversion_rate
    float64 views_moving_avg_7d
    int64 daily_new_subs
    float64 daily_new_subs_pct_growth
    float64 lifetime_views_per_vid
    float64 views_per_vid_30d
    float64 views_per_sub_30d
    int64 sub_rank
    int64 sub_percentile
    int64 lifetime_view_rank
    int64 lifetime_view_percentile
    int64 video_count_rank
    int64 video_count_percentile
    int64 view_rank
    int64 view_percentile
    int64 view_7d_avg_rank
    int64 view_7d_avg_percentile
    int64 views_per_vid_30d_rank
    int64 views_per_vid_30d_percentile
    int64 views_per_sub_30d_rank
    int64 views_per_sub_30d_percentile
    int64 daily_sub_rank
    int64 daily_sub_percentile
    int64 daily_sub_growth_pct_rank
    int64 daily_sub_growth_pct_percentile
    int64 new_videos_30d_rank
    int64 new_videos_30d_percentile
  }

  leaderboard {
    string channel_id PK
    string metric_name PK
    int64 window_days PK "nullable"
    string cohort_type PK
    string cohort_value PK "nullable"
    float64 metric_value
    int64 ranking
    int64 percentile
  }

