@startuml uc_admin_01_auth

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontSize 11
skinparam actorStyle awesome

title <size:18><b>Domain 1 — Authentication & Authorization</b></size>\nUse Case Detail

left to right direction

actor "Owner" as Owner #E8F5E9
actor "Super Admin" as SuperAdmin #E3F2FD
actor "Google Identity\nProvider" as Google #FFECB3

rectangle "Administration System" {

  package "Authentication" as AuthPkg #E8F5E9 {
    usecase "UC-1.1\nAuthenticate\nAdministrator" as UC11
    usecase "UC-1.2\nAuthorize\nAdministrator" as UC12
  }

  package "Account Lifecycle" as AcctPkg #C8E6C9 {
    usecase "UC-1.3\nProvision\nAdministrator" as UC13
    usecase "UC-1.4\nSuspend\nAdministrator" as UC14
    usecase "UC-1.5\nDeprovision\nAdministrator" as UC15
  }

  package "Role Management" as RolePkg #A5D6A7 {
    usecase "UC-1.6\nAssign Role" as UC16
    usecase "UC-1.7\nChange Role" as UC17
    usecase "UC-1.8\nTransfer\nOwnership" as UC18
  }
}

' === Actor connections ===
Owner --> UC11
Owner --> UC12
Owner --> UC13
Owner --> UC14
Owner --> UC15
Owner --> UC16
Owner --> UC17
Owner --> UC18

SuperAdmin --> UC11
SuperAdmin --> UC12
SuperAdmin --> UC13
SuperAdmin --> UC14
SuperAdmin --> UC15
SuperAdmin --> UC16
SuperAdmin --> UC17

Google --> UC11 : "Authenticates\nidentity"

' === Include/Extend relationships ===
UC11 ..> UC12 : <<include>>\nProceeds to\nauthorization

UC18 ..> UC16 : <<include>>\nAssigns new\nrole

' === Notes ===
note bottom of UC11
  **Precondition:** System is deployed,
  Google OAuth configured.
  **Postcondition:** Authenticated
  session established or access denied.
end note

note bottom of UC13
  **Rule:** Super Admin cannot
  create Owner role.
  **Rule:** Auth does not auto-provision.
end note

note bottom of UC18
  **Invariant:** Exactly one Owner
  exists at all times.
  Previous Owner becomes
  Super Admin (or specified).
end note

note right of UC14
  **Protected:** Owner cannot
  be suspended (BR-003).
end note

note right of UC15
  **Protected:** Owner cannot
  be deprovisioned (BR-003).
end note

@enduml
