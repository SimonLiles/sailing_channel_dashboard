@startuml UC-1.3_provision_admin
!theme plain

title Sailing Channel Dashboard Admin — UC-1.3 — Provision Administrator

actor "Owner / Super Admin" as Actor
participant "Provisioning Form\n[presentation]" as ProvisionForm
participant "User Management Service\n[application]" as UserMgmtSvc
participant "Authorization / RBAC Engine\n[application]" as AuthzEngine
database "CloudSQL\n[data store]" as CloudSQL
participant "Audit Service\n[application]" as AuditSvc

Actor -> ProvisionForm : navigate to Users page;\nselect "Provision New Administrator"
activate ProvisionForm

ProvisionForm -> ProvisionForm : display provisioning form

Actor -> ProvisionForm : enter Google identity info;\nselect role

ProvisionForm -> UserMgmtSvc : validate and create account\n(identity, role)
activate UserMgmtSvc

UserMgmtSvc -> AuthzEngine : verify authority\n(Super Admin cannot assign Owner)
activate AuthzEngine
AuthzEngine --> UserMgmtSvc : authorization result
deactivate AuthzEngine

alt Identity already provisioned
  UserMgmtSvc --> ProvisionForm : Failure(DuplicateIdentity)
  deactivate UserMgmtSvc
  ProvisionForm --> Actor : show "identity already provisioned"
  stop

elseif Invalid role or missing fields
  UserMgmtSvc --> ProvisionForm : Failure(InvalidInput)
  deactivate UserMgmtSvc
  ProvisionForm --> Actor : show validation error;\nretain form state
  stop

elseif Super Admin cannot create Owner
  UserMgmtSvc --> ProvisionForm : Failure(InsufficientAuthority)
  deactivate UserMgmtSvc
  ProvisionForm --> Actor : reject: Super Admin\ncannot create Owner (BR-004)
  stop

else Valid — proceed
  UserMgmtSvc -> CloudSQL : create admin account\n(identity, email, role, status: Active)
  activate CloudSQL
  CloudSQL --> UserMgmtSvc : ok
  deactivate CloudSQL

  UserMgmtSvc -> AuditSvc : record: Administrator created\n(actor, target, role, timestamp)
  activate AuditSvc
  AuditSvc -> CloudSQL : append audit record
  CloudSQL --> AuditSvc : ok
  AuditSvc --> UserMgmtSvc : ok
  deactivate AuditSvc

  UserMgmtSvc --> ProvisionForm : Success(adminAccount)
  deactivate UserMgmtSvc
  ProvisionForm --> Actor : show confirmation
  deactivate ProvisionForm
end

@enduml
