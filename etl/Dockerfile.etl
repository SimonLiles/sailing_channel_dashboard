# This is the Docker Container for the yt_sailing_channel_etl_job

# Base R image
FROM --platform=linux/amd64 rocker/tidyverse

# Install R Dependencies
RUN R -e "install.packages('httr')"
RUN R -e "install.packages('jsonlite')"
RUN R -e "install.packages('dplyr')"
RUN R -e "install.packages('bigrquery')"
RUN R -e "install.packages('gargle')"
RUN R -e "install.packages('DBI')"

# Copy over scripts
COPY ../scripts/run_sql.R scripts/run_sql.R
COPY ../scripts/get_yt_data.R scripts/get_yt_data.R

# Copy the script over
COPY main.R main.R

# Run the R script
CMD R -e "source('main.R')"